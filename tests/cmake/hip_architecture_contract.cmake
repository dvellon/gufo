if (NOT DEFINED TEST_ARCHITECTURE OR NOT DEFINED TEST_ALLOW_GFX942)
  message(FATAL_ERROR "test requires TEST_ARCHITECTURE and TEST_ALLOW_GFX942")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/GufoHipArchitecture.cmake")
gufo_resolve_hip_architecture("${TEST_ARCHITECTURE}" "${TEST_ALLOW_GFX942}")

if (DEFINED EXPECT_NAME AND NOT GUFO_HIP_ARCHITECTURE STREQUAL EXPECT_NAME)
  message(FATAL_ERROR "architecture differs: ${GUFO_HIP_ARCHITECTURE}")
endif()
if (DEFINED EXPECT_FAMILY AND NOT GUFO_HIP_ARCHITECTURE_FAMILY STREQUAL EXPECT_FAMILY)
  message(FATAL_ERROR "family differs: ${GUFO_HIP_ARCHITECTURE_FAMILY}")
endif()
if (DEFINED EXPECT_WAVE_SIZE AND NOT GUFO_HIP_WAVE_SIZE STREQUAL EXPECT_WAVE_SIZE)
  message(FATAL_ERROR "wave size differs: ${GUFO_HIP_WAVE_SIZE}")
endif()
if (DEFINED EXPECT_WMMA_WAVE32 AND NOT GUFO_HIP_HAS_WMMA_WAVE32 STREQUAL EXPECT_WMMA_WAVE32)
  message(FATAL_ERROR "WMMA capability differs: ${GUFO_HIP_HAS_WMMA_WAVE32}")
endif()
if (DEFINED EXPECT_MFMA_WAVE64 AND NOT GUFO_HIP_HAS_MFMA_WAVE64 STREQUAL EXPECT_MFMA_WAVE64)
  message(FATAL_ERROR "MFMA capability differs: ${GUFO_HIP_HAS_MFMA_WAVE64}")
endif()
if (DEFINED EXPECT_PRODUCTION AND NOT GUFO_HIP_PRODUCTION_SUPPORTED STREQUAL EXPECT_PRODUCTION)
  message(FATAL_ERROR "production capability differs: ${GUFO_HIP_PRODUCTION_SUPPORTED}")
endif()
